{{> header}}

<h2>Employee List</h2>

{{#if employees.length}}
  <table>
    <thead>
      <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Department</th>
        <th>Start Date</th>
        <th>Job Title</th>
        <th>Salary</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each employees}}
        <tr>
          <td>{{firstName}}</td>
          <td>{{lastName}}</td>
          <td>{{department}}</td>
          <td>{{startDate}}</td>
          <td>{{jobTitle}}</td>
          <td>{{salary}}</td>
          <td class="actions">
            <a href="/update/{{_id}}">Update</a>
            <a href="/delete/{{_id}}">Delete</a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No employees found. Add one from the create page.</p>
{{/if}}

{{> footer}}
